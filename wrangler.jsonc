{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ethantam-dev",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // "/" too, so the Worker can stamp the deploy into the page
    "run_worker_first": ["/api/*", "/"]
  },
  // the deploy's id, time and tag (CI tags it with the commit) for "Last updated"
  "version_metadata": { "binding": "VERSION" },
  // the ticker's hub: one Durable Object streams the watchlist to every visitor (worker/index.js)
  "durable_objects": {
    "bindings": [{ "name": "TICKER", "class_name": "Ticker" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Ticker"] }],
  // PR builds run `wrangler preview`, which needs this block (it can stay empty)
  "previews": {}
}
